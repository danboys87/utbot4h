# ── Bitget API ────────────────────────────────────────────────────────────────
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=

# ── Mode ──────────────────────────────────────────────────────────────────────
DRY_RUN=true

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── AI Analyst ────────────────────────────────────────────────────────────────
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash

# ── Dashboard ─────────────────────────────────────────────────────────────────
DASHBOARD_PORT=3000
# DASHBOARD_SECRET=isi_password_jika_mau_aman

# ── JSONBin (cloud state, opsional) ──────────────────────────────────────────
JSONBIN_API_KEY=
JSONBIN_BIN_ID=

# ── Log Level ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info

